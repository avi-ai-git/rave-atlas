# Berlin Rave Atlas, Streamlit Cloud secrets template
#
# How to use:
#   Local:           copy to .streamlit/secrets.toml and fill in values
#                    (already gitignored, never commit real secrets).
#   Streamlit Cloud: paste each key-value pair into the app's
#                    Settings, Secrets editor in the Streamlit Cloud dashboard.
#                    Streamlit Cloud exposes all secrets as env vars, which is
#                    exactly what config.py reads via os.environ.get().
#
# Required for core functionality:
OPENROUTER_API_KEY = "sk-or-v1-your-key-here"

# Required for enrich_artist (Discogs label and release data):
DISCOGS_TOKEN = "your-discogs-personal-access-token"

# Required for moderation, and for the selectable Mistral Large model. If
# absent, moderate() fails open (allows all) and Mistral Large is unusable.
MISTRAL_API_KEY = "your-mistral-api-key"

# Optional, LangSmith observability. If absent, tracing is simply disabled.
LANGSMITH_API_KEY  = "lsv2_pt_your-key-here"
LANGSMITH_PROJECT  = "berlin rave atlas"
LANGCHAIN_TRACING_V2 = "true"
LANGCHAIN_API_KEY  = "lsv2_pt_your-key-here"
LANGCHAIN_PROJECT  = "berlin rave atlas"

# Optional, Ollama Cloud (the GPT-OSS 120B open-source model in the picker).
OLLAMA_API_KEY  = "your-ollama-cloud-api-key"
OLLAMA_BASE_URL = "https://ollama.com/v1"

# Optional, override the default runtime model. Must be an id from
# AVAILABLE_MODELS in config.py:
#   anthropic/claude-haiku-4.5  |  mistral-large-latest  |  gpt-oss:120b
# Haiku 4.5 is the default: cheapest, fastest, and works without OpenRouter
# privacy-policy configuration.
# DEFAULT_MODEL = "anthropic/claude-haiku-4.5"

# NOTE, Telegram weekend digest:
# The TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID secrets do NOT belong here. The
# Streamlit app never sends Telegram messages; that is done by a GitHub Actions
# cron (.github/workflows/weekend-digest.yml). Add those two as GitHub Actions
# repository secrets instead (Settings, Secrets and variables, Actions).
