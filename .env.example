# Berlin Rave Atlas, environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── LLM: OpenRouter (Anthropic Claude models) ──────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── LLM: Ollama Cloud (open-source models) ────────────────────────────────────
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_BASE_URL=https://ollama.com/v1

# ── Default model (must be an ID from AVAILABLE_MODELS in config.py) ──────────
# Options: anthropic/claude-haiku-4.5  |  mistral-large-latest  |  gpt-oss:120b
DEFAULT_MODEL=anthropic/claude-haiku-4.5

# ── External APIs ──────────────────────────────────────────────────────────────
DISCOGS_TOKEN=your-discogs-personal-access-token
MISTRAL_API_KEY=your-mistral-api-key
# Optional. Enables Brave Search instead of keyless DuckDuckGo. Get a key at
# search.brave.com/api (2 000 free queries/month on the free tier).
BRAVE_SEARCH_API_KEY=

# ── Telegram weekend digest (optional automation) ─────────────────────────────
# Used by automation/weekend_telegram.py, run on a GitHub Actions cron (NOT the
# Streamlit app). Create a bot via @BotFather for the token; TELEGRAM_CHAT_ID is
# the user/group/@channel to post to. Leave blank to disable Telegram sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Observability: LangSmith ──────────────────────────────────────────────────
LANGSMITH_API_KEY=lsv2_pt_your-key-here
LANGSMITH_PROJECT=berlin rave atlas
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your-key-here
LANGCHAIN_PROJECT=berlin rave atlas

# ── Storage (defaults shown; override if needed) ──────────────────────────────
CHROMA_DIR=data/chroma
SQLITE_PATH=data/rave_atlas.db

# ── Safety tunables ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_INPUT_LENGTH=2000
MIN_INPUT_LENGTH=3
# Score above which a message is blocked. 0.85 (not 0.7) so legitimate
# harm-reduction questions are not over-blocked. See config.py for the rationale.
MODERATION_THRESHOLD=0.85
